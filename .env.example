PORT=3030
EWS_PUBLIC_URL=http://127.0.0.1:3030/
EWS_NOTIFICATION_URL=http://127.0.0.1:3030/
EWS_RSS_URL=http://127.0.0.1:3030/rss.xml
CLOUDFLARE_PAGES_PROJECT=warning-watch
CLOUDFLARE_API_TOKEN=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=

EWS_PUBLISHED_DIR=

# Continuous watch. In production, keep its existing funded key only in
# /etc/warning-watch-sources.env, not the web-server environment.
SCRY_API_KEY=
EWS_WATCH_MODEL=google/gemini-2.5-flash-lite
EWS_WATCH_DAILY_BUDGET_USD=0.10
EWS_WATCH_DB_PATH=
EWS_WATCH_ENV_PATH=

# CBRN instrument store (gamma telemetry, aircraft samples, vocabulary
# buckets, detector state). Defaults to data/ews-cbrn.sqlite; no credentials
# are needed because every CBRN instrument is a public endpoint.
EWS_CBRN_DB_PATH=

# Optional Telegram emergency alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL=

# Notification backend secrets for production Pages deploys.
APP_BASE_URL=http://127.0.0.1:3030
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
# Configure at least one Telnyx sender source.
TELNYX_NUMBER=
TELNYX_FROM_PHONE=
TELNYX_MESSAGING_PROFILE_ID=
# Required for Cloudflare Pages internal alert ingestion and post-deploy smoke checks.
INTERNAL_ALERT_TOKEN=
EWS_ALERT_EVENTS_WEBHOOK_URL=https://your-pages-domain.example/api/internal/alert-events
EWS_ALERT_BRIDGE_STATUS_PATH=
NOTIFICATION_HASH_SECRET=
NOTIFICATION_ENCRYPTION_KEY=

WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT=mailto:alerts@example.com

# Alert fanout controls. Defaults send one subscriber batch per invocation; the maintenance worker resumes queued batches every minute.
LEVEL5_SUBSCRIBER_BATCH_SIZE=500
ALERT_EVENT_MAX_BATCHES_PER_INVOCATION=1
ALERT_PROCESSING_STALE_MS=900000
ALERT_FANOUT_LEASE_MS=1800000
# Required for production Pages deploy smoke: both providers must accept a live test message.
EWS_SMOKE_TEST_EMAIL=
EWS_SMOKE_TEST_PHONE=
# Public ntfy push channel (zero-credential). Publishes elevated+ alerts.
EWS_NTFY_TOPIC=
EWS_NTFY_SERVER=https://ntfy.sh
