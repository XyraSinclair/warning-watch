[Unit]
Description=Refresh Warning Watch snapshots
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=xyra
WorkingDirectory=/opt/dev/warning-watch
EnvironmentFile=/etc/warning-watch.env
Environment=NODE_ENV=production
Environment=PATH=/opt/dev/warning-watch/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/node scripts/refresh_all_snapshots.js
TimeoutStartSec=310
TimeoutStopSec=5
KillMode=control-group
NoNewPrivileges=true
