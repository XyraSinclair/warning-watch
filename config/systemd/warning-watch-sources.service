[Unit]
Description=Collect public digital signals and investigate watch incidents
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=xyra
WorkingDirectory=/opt/dev/warning-watch
Environment=NODE_ENV=production
Environment=EWS_WATCH_MODEL=google/gemini-2.5-flash-lite
Environment=EWS_WATCH_DAILY_BUDGET_USD=0.10
EnvironmentFile=-/etc/warning-watch-sources.env
ExecStart=/usr/bin/node scripts/run_watch.js
TimeoutStartSec=240
TimeoutStopSec=10
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
