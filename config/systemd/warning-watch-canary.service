[Unit]
Description=Warning Watch weekly delivery canary
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=xyra
WorkingDirectory=/opt/dev/warning-watch
EnvironmentFile=/etc/warning-watch.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node scripts/canary_delivery.js
NoNewPrivileges=true
